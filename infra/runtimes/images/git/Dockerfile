# syntax=docker/dockerfile:1
# Git — 공식 이미지가 없어 직접 만든다 (#739).
#
# **1.2GB 짜리 C 컴파일러 위에서 돌고 있었다.** #654 가 `gcc:13` 을 고른 이유는
# "거기 git 이 들어 있고, 그 이미지는 이미 모든 노드에 있다" 였는데 **그 전제가
# 깨졌다** — 실행기 파드가 다시 스케줄되면 그 노드에 없고, 그때 받기가 5분 예산을
# 넘겨 취소된다. 운영에서 Git 문제를 아무도 못 푸는 상태가 됐다.
#
# 필요한 것은 `git` 하나다. 30MB 안팎이면 받기가 문제가 아니게 된다.
FROM alpine:3.22

# **버전을 고정한다.** 태그는 다시 붙을 수 있고, 그때 우리가 검증한 것과 다른 것이
# 실행 노드에 들어간다 (#96 이 이미지에 대해 한 판단과 같다).
#
# 알파인 판을 함께 고정하는 것이 핵심이다 — `apk` 의 핀은 그 판의 저장소에만 있어서,
# `alpine:3` 처럼 열어 두면 판이 올라갈 때 이 핀이 조용히 깨진다.
ARG GIT_VERSION=2.49.1-r0

RUN apk add --no-cache "git=${GIT_VERSION}"

# 하네스가 `git config` 를 부른다. 읽기 전용 rootfs 에서 `/` 에 쓰려다 죽지 않게
# 작업 디렉터리로 돌려 둔다 (#709 가 겪은 자리, kotlin·아희 이미지와 같은 이유).
ENV HOME=/work
WORKDIR /work
