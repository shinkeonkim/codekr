# 로컬 개발용 예시 값. `cp .env.example .env` 후 필요한 값만 바꾼다.
# 운영 값은 절대 이 파일에 넣지 않는다 (k8s 에서는 SOPS 로 관리).

# ── 호스트 포트 (로컬 충돌 회피용) ──────────────────────────────
WEB_HOST_PORT=13000
API_HOST_PORT=18080
EXECUTOR_HOST_PORT=18081
JUDGE_HOST_PORT=18082
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=codekr
POSTGRES_USER=codekr
POSTGRES_PASSWORD=codekr_local_pw

# ── API ───────────────────────────────────────────────────────
# 운영에서는 최소 32바이트 랜덤 값을 시크릿으로 주입한다.
CODEKR_JWT_SECRET=local-development-only-secret-change-me-please-32b
CODEKR_JWT_ACCESS_TTL_SECONDS=3600
CODEKR_JWT_REFRESH_TTL_SECONDS=1209600
CODEKR_CORS_ALLOWED_ORIGINS=http://localhost:13000

# ── 보관 정책 (소프트 삭제 행 정리) ───────────────────────────
CODEKR_RETENTION_ENABLED=true
CODEKR_RETENTION_PROBLEM_DAYS=90
CODEKR_RETENTION_PROBLEM_CHILD_DAYS=30

# ── Executor (코드 실행기) ────────────────────────────────────
# 동시에 실행할 샌드박스 컨테이너 수
EXECUTOR_CONCURRENCY=4
# 컴파일 단계 최대 시간(ms). 문제의 시간 제한과 별개로 적용된다.
EXECUTOR_COMPILE_TIMEOUT_MS=15000
# 컴파일 단계 메모리(MB). 툴체인은 사용자 프로그램보다 훨씬 많이 쓰므로 따로 둔다.
EXECUTOR_COMPILE_MEMORY_MB=1024
# stdout/stderr 수집 상한(bytes)
EXECUTOR_MAX_OUTPUT_BYTES=65536

# ── Judge (채점기) ────────────────────────────────────────────
JUDGE_CONCURRENCY=4
# 실행 결과를 기다리는 최대 시간(ms)
JUDGE_EXEC_TIMEOUT_MS=60000

# ── Web ───────────────────────────────────────────────────────
# 브라우저에서 접근하는 API 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:18080

# ── 시드 데이터 계정 ──────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@codekr.dev
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_EMAIL=user@codekr.dev
SEED_USER_PASSWORD=user1234
